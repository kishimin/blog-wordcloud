{
  "name": "kotogumo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:small": "npm run test:small --workspaces --if-present",
    "test:medium": "npm run test:medium --workspaces --if-present",
    "test:large": "npm run test:large --workspaces --if-present",
    "test:pr": "npm run test:pr --workspaces --if-present",
    "test:nightly": "npm run test:nightly --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:coverage:small": "npm run test:coverage:small --workspaces --if-present",
    "test:coverage:pr": "npm run test:coverage:pr --workspaces --if-present",
    "test:coverage:nightly": "npm run test:coverage:nightly --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
