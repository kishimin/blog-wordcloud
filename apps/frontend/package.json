{
  "name": "@kotogumo/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:small": "vitest run --passWithNoTests small.test",
    "test:medium": "vitest run --passWithNoTests medium.test",
    "test:large": "vitest run --passWithNoTests large.test",
    "test:pr": "vitest run --passWithNoTests small.test medium.test",
    "test:nightly": "vitest run --passWithNoTests small.test medium.test large.test",
    "test:coverage": "vitest run --coverage",
    "test:coverage:small": "vitest run --coverage --passWithNoTests small.test",
    "test:coverage:pr": "vitest run --coverage --passWithNoTests small.test medium.test",
    "test:coverage:nightly": "vitest run --coverage --passWithNoTests small.test medium.test large.test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
